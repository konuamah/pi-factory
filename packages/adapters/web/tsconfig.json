{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true
  },
  "references": [
    { "path": "../../core" },
    { "path": "../../schemas" }
  ],
  "include": ["src/**/*.ts"]
}